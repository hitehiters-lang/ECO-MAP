{
    "swagger": "2.0",
    "info": {
        "description": "Документация к API.",
        "title": "Eco Map API 2",
        "contact": {},
        "version": "0.14"
    },
    "basePath": "/",
    "paths": {
        "/api/air/measurements": {
            "get": {
                "description": "Возвращает все пробы воздуха за дату ДО и ПОСЛЕ",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пробы"
                ],
                "summary": "Получить все пробы воздуха за период времени",
                "operationId": "air_measurements",
                "parameters": [
                    {
                        "type": "string",
                        "default": "2024-02-01",
                        "example": "2024-02-01",
                        "description": "Дата с (YYYY-MM-DD)",
                        "name": "date_from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "default": "2024-02-28",
                        "example": "2024-02-28",
                        "description": "Дата до (YYYY-MM-DD)",
                        "name": "date_to",
                        "in": "query",
                        "required": true
                    },
                    {
                        "enum": [
                            "01:00",
                            "07:00",
                            "12:00",
                            "18:00"
                        ],
                        "type": "string",
                        "description": "Время пробы",
                        "name": "time",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Measure"
                            }
                        }
                    },
                    "400": {
                        "description": "{\"error\": \"bad datetime request\"}"
                    },
                    "404": {
                        "description": "{\"error\": \"air samples not found\"}"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "description": "Вход по логину и паролю. Возвращает JWT",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Аутентификация"
                ],
                "summary": "Войти",
                "operationId": "log_in",
                "parameters": [
                    {
                        "description": "Данные пользователя",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.LoginBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "{\"token\": \"token\", \"type\": \"bearer\"}"
                    },
                    "404": {
                        "description": "{\"error\": \"invalid credentials\"}"
                    },
                    "500": {
                        "description": "{\"error\": \"internal server error\"}"
                    }
                }
            }
        },
        "/api/categories/list": {
            "get": {
                "description": "Возвращает все категории организаций и контейнерных площадок",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Категории"
                ],
                "summary": "Получить все категории",
                "operationId": "get_categories",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Category"
                            }
                        }
                    },
                    "404": {
                        "description": "{\"error\": \"categories not found\"}"
                    }
                }
            }
        },
        "/api/cities/list": {
            "get": {
                "description": "Возвращает список всех городов",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Города"
                ],
                "summary": "Получить все города",
                "operationId": "get_cities",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.City"
                            }
                        }
                    },
                    "404": {
                        "description": "{\"error\": \"cities not found\"}"
                    }
                }
            }
        },
        "/api/orgs/{city_id}": {
            "get": {
                "description": "Возвращает все организации в городе",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Организации"
                ],
                "summary": "Получить все организации в определённом городе",
                "operationId": "get_organizations",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "example": 1,
                        "description": "ID города",
                        "name": "city_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Organization"
                            }
                        }
                    },
                    "400": {
                        "description": "{\"error\": \"bad city id request\"}"
                    },
                    "404": {
                        "description": "{\"error\": \"organizations not found\"}"
                    }
                }
            }
        },
        "/api/users/list": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Возвращает список всех пользователей",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пользователи"
                ],
                "summary": "Получить всех пользователей",
                "operationId": "get_users",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.UserPublic"
                            }
                        }
                    },
                    "401": {
                        "description": "{\"error\": \"unauthorized\"}"
                    },
                    "403": {
                        "description": "{\"error\": \"not superuser\"}"
                    },
                    "404": {
                        "description": "{\"error\": \"users not found\"}"
                    }
                }
            }
        },
        "/ws/sensors": {
            "get": {
                "description": "Пример вебсокета. Сам роут не работает",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Датчики"
                ],
                "summary": "Получение резултатов датчика (Websocket)",
                "operationId": "sensors_ws",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Sensor"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    }
                }
            }
        }
    },
