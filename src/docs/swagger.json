{
    "swagger": "2.0",
    "info": {
        "description": "Документация к API.",
        "title": "Eco Map API 2",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/api/air/measurements": {
            "get": {
                "description": "Возвращает все пробы воздуха за дату ДО и ПОСЛЕ",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пробы"
                ],
                "summary": "Получить все пробы воздуха за период времени",
                "operationId": "air_measurements",
                "parameters": [
                    {
                        "type": "string",
                        "default": "2024-02-01",
                        "example": "2024-02-01",
                        "description": "Дата с (YYYY-MM-DD)",
                        "name": "date_from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "default": "2024-02-28",
                        "example": "2024-02-28",
                        "description": "Дата до (YYYY-MM-DD)",
                        "name": "date_to",
                        "in": "query",
                        "required": true
                    },
                    {
                        "enum": [
                            "01:00",
                            "07:00",
                            "12:00",
                            "18:00"
                        ],
                        "type": "string",
                        "description": "Время пробы",
                        "name": "time",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/schemas.AirMeasurements"
                            }
                        }
                    },
                    "400": {
                        "description": "{\"error\": \"bad datetime request\"}"
                    },
                    "404": {
                        "description": "{\"error\": \"air samples not found\"}"
                    }
                }
            }
        }
    },
    "definitions": {
        "schemas.AirMeasurements": {
            "type": "object",
            "properties": {
                "ch2O": {
                    "type": "number"
                },
                "co": {
                    "type": "number"
                },
                "coordX": {
                    "type": "number"
                },
                "coordY": {
                    "type": "number"
                },
                "createdAt": {
                    "type": "string"
                },
                "cxhy": {
                    "type": "number"
                },
                "h2S": {
                    "type": "number"
                },
                "humidityPct": {
                    "type": "number"
                },
                "id": {
                    "type": "integer"
                },
                "no": {
                    "type": "number"
                },
                "no2": {
                    "type": "number"
                },
                "pm10": {
                    "type": "number"
                },
                "pm25": {
                    "type": "number"
                },
                "pointID": {
                    "type": "string"
                },
                "pointName": {
                    "type": "string"
                },
                "pressureMmhg": {
                    "type": "number"
                },
                "rsh": {
                    "type": "number"
                },
                "sampleDatetime": {
                    "type": "string"
                },
                "sampleTime": {
                    "type": "string"
                },
                "so2": {
                    "type": "number"
                },
                "temperatureC": {
                    "type": "number"
                },
                "vv": {
                    "type": "number"
                },
                "windDirection": {
                    "type": "string"
                },
                "windSpeedMs": {
                    "type": "number"
                }
            }
        }
    }
}